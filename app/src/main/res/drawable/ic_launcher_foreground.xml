<?xml version="1.0" encoding="utf-8"?>
<!-- A locked amber journal with a ribbon bookmark beside the spine.
     The keyhole is a true cutout, so the same drawable works for themed (monochrome) icons
     and the notification icon. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:scaleX="0.85"
        android:scaleY="0.85"
        android:translateX="14.9"
        android:translateY="13.2">
        <!-- cover with keyhole cut out -->
        <path
            android:fillColor="#FFB300"
            android:fillType="evenOdd"
            android:pathData="M29,14 H63 A5,5 0 0 1 68,19 V67 A5,5 0 0 1 63,72 H29 A5,5 0 0 1 24,67 V19 A5,5 0 0 1 29,14 Z M47.4,43.3 A6,6 0 1 1 52.6,43.3 L55,54 L45,54 Z" />
        <!-- spine -->
        <path
            android:fillColor="#C98A00"
            android:pathData="M29,14 H31 V72 H29 A5,5 0 0 1 24,67 V19 A5,5 0 0 1 29,14 Z" />
        <!-- ribbon bookmark -->
        <path
            android:fillColor="#FFC94D"
            android:pathData="M34,70 L34,82 L38,78 L42,82 L42,70 Z" />
    </group>
</vector>
