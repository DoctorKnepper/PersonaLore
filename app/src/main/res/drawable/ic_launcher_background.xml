            <gradient
                android:type="linear"
                android:startX="54" android:startY="0"
                android:endX="54" android:endY="108">
                <item android:offset="0" android:color="#FF4A1F29" />
                <item android:offset="0.72" android:color="#FFD85029" />
                <item android:offset="1" android:color="#FFE0582D" />
